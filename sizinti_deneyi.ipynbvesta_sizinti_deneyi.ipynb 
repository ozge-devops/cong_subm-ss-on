        "import numpy as np\n",
        "from sklearn.metrics import roc_auc_score\n",
        "from lightgbm import LGBMClassifier\n",
        "\n",
        "def preds_numeric(px, embargo, seed=0):\n",
        "    flags = anomaly_flags(px[\"Close\"]).to_numpy()\n",
        "    n = DAILY[\"chart_bars\"]\n",
        "    X, y = [], []\n",
        "    for i in range(n, len(px)-embargo-1):\n",
        "        lab = flags[i+embargo:i+embargo+1]\n",
        "        if len(lab) == 0: continue\n",
        "        X.append(window_features(px, i, n)); y.append(int(lab.any()))\n",
        "    X = np.nan_to_num(np.array(X), nan=0., posinf=0., neginf=0.)\n",
        "    y = np.array(y)\n",
        "    cut = int(0.80*len(X))\n",
        "    clf = LGBMClassifier(n_estimators=400, learning_rate=0.05,\n",
        "                         random_state=seed, verbose=-1).fit(X[:cut], y[:cut])\n",
        "    return y[cut:], clf.predict_proba(X[cut:])[:,1]\n",
        "\n",
        "def boot_ci(y, p, n_boot=1000, seed=0):\n",
        "    rng = np.random.default_rng(seed)\n",
        "    b = []\n",
        "    for _ in range(n_boot):\n",
        "        i = rng.integers(0, len(y), len(y))\n",
        "        if len(np.unique(y[i])) < 2: continue\n",
        "        b.append(roc_auc_score(y[i], p[i]))\n",
        "    return roc_auc_score(y, p), np.percentile(b, 2.5), np.percentile(b, 97.5)\n",
        "\n",
        "def boot_diff(y0, p0, y1, p1, n_boot=1000, seed=0):\n",
        "    rng = np.random.default_rng(seed)\n",
        "    d = []\n",
        "    for _ in range(n_boot):\n",
        "        i0 = rng.integers(0, len(y0), len(y0))\n",
        "        i1 = rng.integers(0, len(y1), len(y1))\n",
        "        if len(np.unique(y0[i0])) < 2 or len(np.unique(y1[i1])) < 2: continue\n",
        "        d.append(roc_auc_score(y0[i0], p0[i0]) - roc_auc_score(y1[i1], p1[i1]))\n",
        "    return np.percentile(d, 2.5), np.percentile(d, 97.5)\n",
        "\n",
        "DAILY[\"k_sigma\"] = 2.0\n",
        "print(\"Piyasa      E   poz   AUC    %95 GA\")\n",
        "print(\"-\" * 46)\n",
        "\n",
        "for isim, df in [(\"BIST100\", data), (\"S&P500\", sp500), (\"Nikkei225\", nikkei)]:\n",
        "    y0, p0 = preds_numeric(df, 0)\n",
        "    y10, p10 = preds_numeric(df, 10)\n",
        "    a0 = boot_ci(y0, p0)\n",
        "    a10 = boot_ci(y10, p10)\n",
        "    dlo, dhi = boot_diff(y0, p0, y10, p10)\n",
        "    print(\"%-11s 0  %4d  %.3f  [%.3f, %.3f]\" % (isim, y0.sum(), a0[0], a0[1], a0[2]))\n",
        "    print(\"%-11s 10 %4d  %.3f  [%.3f, %.3f]\" % (\"\", y10.sum(), a10[0], a10[1], a10[2]))\n",
        "    print(\"%-11s fark: %+.1f puan  GA [%+.1f, %+.1f]\\n\" % (\n",
        "        \"\", (a0[0]-a10[0])*100, dlo*100, dhi*100))"
