      "source": [
        "import numpy as np\n",
        "from lightgbm import LGBMClassifier\n",
        "from sklearn.metrics import f1_score, roc_auc_score\n",
        "\n",
        "DAILY = dict(rv_window=5, lookback_bars=250, k_sigma=2.0, chart_bars=60)\n",
        "\n",
        "def realized_volatility(close, window=5):\n",
        "    return np.log(close).diff().rolling(window).std()\n",
        "\n",
        "def anomaly_flags(close):\n",
        "    rv = realized_volatility(close, DAILY[\"rv_window\"])\n",
        "    lb = DAILY[\"lookback_bars\"]\n",
        "    mu = rv.shift(1).rolling(lb, min_periods=lb//4).mean()\n",
        "    sd = rv.shift(1).rolling(lb, min_periods=lb//4).std()\n",
        "    return (rv > mu + DAILY[\"k_sigma\"]*sd).fillna(False)\n",
        "\n",
        "def window_features(px, i, n):\n",
        "    w = px.iloc[i-n:i]\n",
        "    c = w[\"Close\"].to_numpy(); h = w[\"High\"].to_numpy()\n",
        "    l = w[\"Low\"].to_numpy();   v = w[\"Volume\"].to_numpy()\n",
        "    r = np.diff(np.log(c), prepend=np.log(c[0]))\n",
        "    hl = np.log(h/np.maximum(l,1e-9))\n",
        "    return np.array([\n",
        "        r.std(), r.mean(), np.abs(r).max(), hl.mean(), hl.std(),\n",
        "        c[-1]/c[0]-1.0, v.std()/(v.mean()+1e-9),\n",
        "        realized_volatility(w[\"Close\"], DAILY[\"rv_window\"]).iloc[-1],\n",
        "        np.percentile(np.abs(r),90),\n",
        "        float(np.sum(np.abs(r) > 2*(r.std()+1e-12))),\n",
        "        np.abs(r[-5:]).mean(), np.abs(r[-10:]).std(),\n",
        "    ])\n",
        "\n",
        "def run_numeric(px, embargo, seed=0):\n",
        "    flags = anomaly_flags(px[\"Close\"]).to_numpy()\n",
        "    n = DAILY[\"chart_bars\"]\n",
        "    X, y, _ = [], [], []\n",
        "    for i in range(n, len(px)-embargo-1):\n",
        "        lab = flags[i+embargo:i+embargo+1]\n",
        "        if len(lab)==0: continue\n",
        "        X.append(window_features(px, i, n)); y.append(int(lab.any())); _.append(i)\n",
        "    X = np.nan_to_num(np.array(X), nan=0., posinf=0., neginf=0.)\n",
        "    y = np.array(y)\n",
        "    cut = int(0.80*len(X))\n",
        "    if len(np.unique(y[cut:])) < 2:\n",
        "        return dict(embargo=embargo, auc=float(\"nan\"), f1=float(\"nan\"))\n",
        "    clf = LGBMClassifier(n_estimators=400, learning_rate=0.05, random_state=seed, verbose=-1).fit(X[:cut], y[:cut])\n",
        "    p = clf.predict_proba(X[cut:])[:,1]\n",
        "    return dict(embargo=embargo, auc=float(roc_auc_score(y[cut:], p)), f1=float(f1_score(y[cut:], (p>.5).astype(int), average=\"macro\")))\n",
        "\n",
        "print(\"Fonksiyonlar tanımlandı\")"
      ],
